# Copie para .env (docker compose lê-o automaticamente). Todos os valores são opcionais.

# Primeiro administrador. Se ADMIN_PASSWORD ficar vazio, é gerada uma palavra-passe
# aleatória e escrita nos logs do contentor da API (docker compose logs api).
ADMIN_EMAIL=admin@unedo4all.local
ADMIN_NAME=Administrador
ADMIN_PASSWORD=

# Segredo das sessões. Se vazio, é gerado e guardado no volume de dados.
JWT_SECRET=

# URL público do site (sitemap, links absolutos, SEO).
SITE_URL=http://localhost:8080

# Ponha true quando servir o site em HTTPS (cookie de sessão só por HTTPS).
COOKIE_SECURE=false

# Porta local do site.
WEB_PORT=8080

# --- Apenas para `npm run dev` / build do site sem Docker ---
# Origem pública do site usada em canonical, Open Graph e sitemap (sem barra final).
# (No Docker é usado SITE_URL acima.)
# VITE_SITE_URL=https://medronho.vercel.app
